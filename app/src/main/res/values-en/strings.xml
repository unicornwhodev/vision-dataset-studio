    <string name="batch_preannotate_body">The model will process one pending image at a time. Existing corrections and decisions will be preserved. No proposal will be validated automatically. Keep the app open.</string>
    <string name="batch_reject_failures_body">Images that could not be retrieved will be excluded from the dataset with their failure reason. This action fixes no file and validates no image.</string>
