    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <application>
        <service android:name=".UiDriverService" android:exported="true"
            android:permission="android.permission.DUMP" android:foregroundServiceType="specialUse">
